{
  "name": "meonet-nextjs-app",
  "version": "11.3.4",
  "license": "MIT",
  "private": true,
  "description": "Next.js web app, blog, url shortener and pastebin",
  "keywords": [
    "nextjs",
    "vercel",
    "react",
    "typescript",
    "tailwindcss",
    "markdown",
    "mdx",
    "api",
    "backend",
    "frontend",
    "pwa",
    "url-shortener",
    "pastebin",
    "supabase"
  ],
  "author": {
    "name": "Muhammad Amin Boubaker",
    "username": "CodeIter",
    "email": "muhammadaminboubaker@gmail.com",
    "url": "https://github.com/CodeIter"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeIter/meonet-nextjs-app.git"
  },
  "bugs": {
    "url": "https://github.com/CodeIter/meonet-nextjs-app.git/issues"
  },
  "homepage": "https://github.com/CodeIter/meonet-nextjs-app.git#readme",
  "type": "module",
  "scripts": {
    "dev": "concurrently -p none 'cross-env NODE_ENV=development serwist build --watch' 'cross-env NODE_ENV=development next dev --turbopack'",
    "dev:webpack": "concurrently -p none 'cross-env NODE_ENV=development serwist build --watch' 'cross-env NODE_ENV=development next dev --webpack'",
    "dev:once": "cross-env NODE_ENV=development serwist build && cross-env NODE_ENV=development next dev --turbopack",
    "build": "cross-env NODE_ENV=production next build --turbopack && cross-env NODE_ENV=production serwist build",
    "build:webpack": "cross-env NODE_ENV=production next build --webpack && cross-env NODE_ENV=production serwist build && pnpm postbuild",
    "postbuild": "cpx \"public/**/*\" .next/standalone/public && cpx \".next/static/**/*\" .next/standalone/.next/static",
    "start": "cross-env NODE_ENV=production node .next/standalone/server.js",
    "next:start": "cross-env NODE_ENV=production next start",
    "lint": "eslint ."
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": "^22 || ^23 || ^24 || ^25 || ^26"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "he": "^2.0.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github": "^12.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.15",
    "@serwist/next": "^9.5.15",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/he": "^1.2.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.7",
    "cpx2": "^9.0.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "serwist": "^9.5.15",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
