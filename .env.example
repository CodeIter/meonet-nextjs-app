# DotEnv file

# Set the Node.js environment for the application.
# "production" enables optimizations (e.g., caching, minification),
# turns off verbose logging, and disables debug features.
NODE_ENV=production
#NODE_ENV=development

# Application host & port & protocol
HOST=0.0.0.0
HOSTNAME=${HOST}
PORT=3000
PROTO=http

# Rate Limiting Configuration
# Number of requests allowed in the window
RATE_LIMIT_MAX_REQUESTS=50
# Time window in seconds
RATE_LIMIT_WINDOW_SIZE=60

# Supabase configuration
# Supabase URL
PUBLIC_SUPABASE_URL=
# Supabase Anon Key
PUBLIC_SUPABASE_ANON_KEY=
