{

  "root": true,

  "parser": "@typescript-eslint/parser",

  "plugins": [
    "@typescript-eslint"
  ],

  "extends": [
    "next/core-web-vitals",
    "next/typescript",
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],

  "rules": {

    "@typescript-eslint/no-unused-vars": [
      "error", {
        "vars": "all",
        "args": "after-used",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_"
      }
    ]

  }

}

